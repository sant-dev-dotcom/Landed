# Muse Spark: all chat, document analysis, planning and event discovery.
MUSE_API_KEY=your_api_key_here
# Gemini: UI and webpage translation, including translated event descriptions.
GEMINI_API_KEY=your_api_key_here
SERPAPI_KEY=your_api_key_here

# Sign-in (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Shared cache for AI translations and formatted pages (Vultr Managed Valkey or any Redis).
# Use rediss:// for TLS. Leave empty to cache in memory on each server.
VALKEY_URL=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite   # free tier allows only 20 requests/day for gemini-3.5-flash
# META_MODEL_API_BASE=https://api.meta.ai/v1
# MUSE_SEARCH_MODEL=muse-spark-1.3   # shared by Muse chat and web search
